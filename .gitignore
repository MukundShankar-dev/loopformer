.DS_Store

# Local Python virtual environments and bytecode
.venv/
venv/
.venv-probe/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated datasets are reproducible from code + recorded seeds/configuration.
data/

# Keep run metadata, JSON/JSONL metrics, CSV trajectories, and checkpoint
# pointers trackable in models/, eval/, and artifacts/. Git has no size rules.
# Exclude model/adapter tensors, optimizer state, and binary exports.
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.gguf
*.onnx

# Repeated pretrained tokenizer payloads; small checkpoint configs stay visible.
/models/**/tokenizer.json
/models/**/vocab.json
/models/**/merges.txt
/models/**/tokenizer.model
/models/**/spiece.model

# Download/build caches and artifact bundles.
.cache/
.triton/
*.tar
*.tar.gz
*.tgz
*.zip

# Large optional profiler traces; small summaries/operator tables remain trackable.
/eval/pointer_profiles/**/trace.json*

# W&B SDK cache; keep wandb_run.json provenance trackable.
wandb/

# Oversized local launcher log; keep it out of GitHub while retaining it locally.
/models/stage1_pointer/executor_r-seed61-launch-20261004T210218Z-581.log

# macOS AppleDouble metadata.
._*

# Per-question MMLU sample logs (~360 MB); summaries, protocol and paired.csv stay tracked.
/eval/general/**/mmlu_*.jsonl
/eval/general/**/launcher.lock
